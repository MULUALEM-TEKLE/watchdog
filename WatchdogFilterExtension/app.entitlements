<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sample entitlements for the APP target (watchdog). See BLOCKING.md. -->
	<!-- The app must stay UNSANDBOXED (ENABLE_APP_SANDBOX = NO): sandboxing
	     breaks nettop spawning and proc_pidpath, killing all monitoring. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.watchdog.shared</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>content-filter-provider</string>
	</array>
	<key>com.apple.developer.system-extension.install</key>
	<true/>
</dict>
</plist>
